  "webManifestUrl": "https://herobot-ai.com/manifest.webmanifest",
  "appVersion": "1.0.0",
  "appVersionCode": 1,
  "fallbackType": "customtabs",
  "signingKey": { "path": "./herobot-upload.keystore", "alias": "herobot" },
